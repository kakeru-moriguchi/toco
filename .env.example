# ------------------------------------------------------------
# Supabase（プロジェクト作成後、Project Settings → API からコピー）
# ------------------------------------------------------------
# 例: https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public キー。参加者のブラウザに渡るが、RLS により「読み取り」しかできない。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role キー。サーバー側だけで使う。絶対に公開しないこと。
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# 管理画面のパスワード（主催者だけが知っている文字列にする）
# ------------------------------------------------------------
ADMIN_PASSWORD=

# ログインCookieの署名に使うランダム文字列。
# 未設定でも動くが、本番では必ず設定する。
#   生成例: openssl rand -base64 32
ADMIN_SESSION_SECRET=
